# Database
DATABASE_URL=sqlite:///./fixradar.db

# AI provider (optional). Leave blank to run on the built-in heuristic analyzer.
AI_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional integrations
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_JSON=

# Crawler
CRAWLER_MAX_PAGES=200
CRAWLER_MAX_DEPTH=6
CRAWLER_CONCURRENCY=4
CRAWLER_REQUEST_TIMEOUT_MS=15000
CRAWLER_USER_AGENT=OmniFitFixRadar/1.0 (+internal audit tool)

# API
CORS_ORIGINS=http://localhost:5173
